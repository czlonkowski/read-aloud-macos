<?xml version="1.0" encoding="UTF-8"?>
<!--
Template only — `install-sidecar.sh` expands the placeholders below and writes
the resolved plist to ~/Library/LaunchAgents/com.czlonkowski.readaloud-sidecar.plist.

Keep this file in sync with the heredoc inside `install-sidecar.sh`.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.czlonkowski.readaloud-sidecar</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{VENV_DIR}}/bin/python</string>
        <string>-m</string>
        <string>read_aloud_tts.server</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HF_HOME</key>
        <string>{{SUPPORT_DIR}}/huggingface</string>
        <key>PYTORCH_ENABLE_MPS_FALLBACK</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/sidecar.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/sidecar.err.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
